APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./lumina.sqlite3
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://tauri.localhost,tauri://localhost
VECTOR_BACKEND=chroma
CHROMA_PATH=./data/chroma
FAISS_INDEX_PATH=./data/faiss/activity.index
LOCAL_INFERENCE=true
CLOUD_INFERENCE_PROVIDER=disabled
OCR_ENGINE=auto
OCR_LANGUAGES=en
OCR_INTERVAL_SECONDS=4
OCR_START_DELAY_SECONDS=0.2
OCR_EVERY_N_FRAMES=10
OCR_MAX_SIDE=640
OCR_ROI_ENABLED=true
OCR_THREADS=4
OCR_MIN_CHANGED_RATIO=0.025
OCR_MAX_STALE_SECONDS=30
MODEL_DIR=./models
ACTIVITY_CHECKPOINT=./models/activity_classifier_best.pt
REQUIRE_ACTIVITY_CHECKPOINT=false
ALLOW_HEURISTIC_CLASSIFIER=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
REASONING_MODEL=google/flan-t5-base
FRAME_PROCESSING_FPS=2
MAX_FRAME_QUEUE=2
MAX_FRAME_BYTES=5000000
INFERENCE_MAX_SIDE=960
LATEST_FRAME_ONLY=true
CPU_OPTIMIZED_MODE=auto
CPU_LIGHTWEIGHT_CONTEXT=true
CPU_LIGHTWEIGHT_TUTOR=true
MEMORY_WRITE_INTERVAL_SECONDS=10
ENABLE_GPU=false
LOG_LEVEL=INFO
API_KEY=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
TRAINING_METRICS_PATH=
